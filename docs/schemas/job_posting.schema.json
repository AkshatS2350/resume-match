    "DegreeLevel": {
      "enum": [
        "none",
        "associate",
        "bachelors",
        "masters",
        "doctorate"
      ],
      "title": "DegreeLevel",
      "type": "string"
    },
    "EducationRequirement": {
      "additionalProperties": false,
      "properties": {
        "degree_level": {
          "anyOf": [
            {
              "$ref": "#/$defs/DegreeLevel"
