      "required": [
        "requirement_id",
        "classification",
        "low_confidence",
        "canonical_skill_id",
        "unit_text",
        "start_offset",
        "end_offset",
        "unit_id",
        "excluded_category",
        "pattern_set_version",
        "delimitation_version"
      ],
      "title": "ExtractedRequirement",
      "type": "object"
    },
