        "low_confidence": {
          "title": "Low Confidence",
          "type": "boolean"
        },
        "pattern_set_version": {
          "title": "Pattern Set Version",
          "type": "string"
        },
        "requirement_id": {
          "title": "Requirement Id",
          "type": "string"
        },
        "start_offset": {
          "title": "Start Offset",
          "type": "integer"
        },
        "unit_id": {
          "title": "Unit Id",
          "type": "string"
        },
        "unit_text": {
          "title": "Unit Text",
          "type": "string"
        }
