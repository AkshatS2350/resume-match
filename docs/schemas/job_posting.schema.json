          "type": "string"
        }
      },
      "required": [
        "requirement_kind"
      ],
      "title": "EducationRequirement",
      "type": "object"
    },
    "EmploymentType": {
      "enum": [
        "full_time",
        "part_time",
        "contract",
        "internship",
        "temporary",
        "unknown"
      ],
